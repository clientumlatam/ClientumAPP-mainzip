# ============================================================
# CLIENTUMCRM - VARIABLES DEL RUNTIME
# ============================================================
# Plantilla sin valores reales. En Replit, guarda los secretos en Secrets.
# Nunca pegues credenciales en este archivo, en localStorage o en el chat.
#
# Separación:
# - Variables de plataforma: backend o configuración pública VITE_*.
# - Credenciales de cada workspace: formulario de módulos, cifradas en
#   clientum_tenant_credentials; no son variables de entorno.

# --- Servidor y modo de ejecución ---
PORT=5000
NODE_ENV=development
# Vite: usar true solo para una sesión local sin HMR.
DISABLE_HMR=false

# --- Persistencia administrada ---
# Replit puede inyectar DATABASE_URL o PGHOST/PGPORT/PGUSER/PGPASSWORD/
# PGDATABASE. No los copies desde otro entorno ni los solicites manualmente.
# DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
#
# Solo para pruebas o desarrollo sin PostgreSQL: rutas opcionales del fallback
# cifrado local. No usar este fallback como almacenamiento multi-tenant.
# USER_CREDENTIAL_STORE_PATH=
# USER_API_KEY_STORE_PATH=

# --- Cifrado y API Keys internas ---
# WORKFLOW_ENCRYPTION_KEY es la opción principal. API_KEY_PEPPER y
# SESSION_SECRET son fallbacks técnicos; configura al menos una clave real.
WORKFLOW_ENCRYPTION_KEY=
API_KEY_PEPPER=
SESSION_SECRET=
# IDs Firebase separados por coma que pueden administrar claves de otros
# usuarios. En desarrollo también se acepta el rol demo de administrador.
CLIENTUM_API_KEY_ADMIN_IDS=

# --- IA de plataforma ---
# Opcional: si falta o es un placeholder, los endpoints usan fallback.
GEMINI_API_KEY=

# --- Firebase cliente ---
# Se inyectan en el bundle del navegador. Son configuración pública, no
# secretos; restringe la clave y los dominios desde Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- SMTP de plataforma ---
# Se consumen por /api/email/status y /api/email/send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ClientumCRM

# --- Webhook de WhatsApp/Meta de la plataforma ---
# El runtime actual usa estas dos variables únicamente para validar la firma
# y el challenge del webhook. Aunque el catálogo también permite campos con
# estos nombres por workspace para una futura integración outbound, el webhook
# actual lee exclusivamente process.env.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ============================================================
# CREDENCIALES POR WORKSPACE: NO PONER VALORES AQUÍ
# ============================================================
# Se introducen desde Configuración del módulo y se cifran en el backend:
#
# WhatsApp/Meta por workspace (reservado para integración outbound):
#   WHATSAPP_ACCESS_TOKEN
#   WHATSAPP_APP_SECRET
#   WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_BUSINESS_ACCOUNT_ID
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN
#
# AFIP:
#   AFIP_CUIT
#   AFIP_ENVIRONMENT
#   AFIP_CERTIFICATE_P12_BASE64
#   AFIP_PRIVATE_KEY
#   AFIP_PRIVATE_KEY_PASSWORD
#
# Mercado Pago:
#   MERCADOPAGO_ACCESS_TOKEN
#   MERCADOPAGO_WEBHOOK_SECRET
#   MERCADOPAGO_PUBLIC_KEY
#
# Google Maps server-side:
#   GOOGLE_MAPS_SERVER_API_KEY
#
# No se devuelven los valores completos al navegador. La búsqueda de Places
# usa GOOGLE_MAPS_SERVER_API_KEY del workspace cuando está configurada.

# ============================================================
# AÚN NO CONECTADAS AL RUNTIME
# ============================================================
# Estos nombres aparecen en el inventario funcional, pero no deben agregarse
# como si habilitaran una integración: el código actual no los consume.
# Cloudflare/D1/R2, Mercado Pago, AFIP, Shopify, Slack, Google OAuth,
# Resend/SendGrid, SMS, N8N, Make, Zapier, PostHog y analítica externa.
# También APP_URL no se consume actualmente para construir URLs canónicas.
