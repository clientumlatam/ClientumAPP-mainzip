# ============================================================
# CLIENTUMCRM - PLATFORM ENVIRONMENT
# ============================================================
# Este archivo es una plantilla. Los valores reales van en Replit Secrets
# y nunca se deben commitear ni pegar en el chat.
# Regla: platform secrets viven aquí; tenant secrets viven cifrados en
# PostgreSQL; VITE_* solo contiene configuración pública del navegador.

# --- Core server configuration ---
# Secret consumed by the AI endpoints in server.ts.
GEMINI_API_KEY=
# Reserved for server-side sessions/cookies/CSRF when enabled.
SESSION_SECRET=
# Public runtime configuration (not a secret).
APP_URL=
NODE_ENV=development

# --- Firebase client configuration ---
# These VITE_* values are bundled into the browser. They are public
# configuration, not server secrets, and must be restricted in Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================================
# OPTIONAL PLATFORM CONNECTORS
# Add only when the corresponding module is connected in backend code.
# Keep server-only credentials outside VITE_* variables.
# ============================================================

# Payments: solo si la plataforma usa una cuenta compartida.
# Las credenciales por empresa van cifradas en clientum_tenant_credentials.
VITE_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ENVIRONMENT=sandbox

# Google Maps browser key, restringida por dominio y APIs.
VITE_GOOGLE_MAPS_API_KEY=

# SMTP platform delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ClientumCRM
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMS: choose one provider, do not configure all three.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_SIGNING_SECRET=

# Cloudflare Webmail / D1 / Domains
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL_WORKER_URL=
CLOUDFLARE_EMAIL_WORKER_SECRET=

# Optional platform providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ============================================================
# PLATFORM SECURITY
# ============================================================
WORKFLOW_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=
API_KEY_PEPPER=
# Comma-separated Firebase user IDs allowed to manage API Keys for other users.
# In development, the demo administrator role is accepted instead.
CLIENTUM_API_KEY_ADMIN_IDS=

# ============================================================
# TENANT CREDENTIALS (DO NOT PUT VALUES IN .ENV)
# ============================================================
# These fields are entered from the module settings UI and encrypted in
# clientum_tenant_credentials. They are scoped by tenant_id and never sent
# to the browser after saving.
#
# WhatsApp / Meta:
#   WHATSAPP_ACCESS_TOKEN
#   WHATSAPP_APP_SECRET
#   WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_BUSINESS_ACCOUNT_ID
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN
#
# AFIP:
#   AFIP_CUIT
#   AFIP_ENVIRONMENT
#   AFIP_CERTIFICATE_P12_BASE64
#   AFIP_PRIVATE_KEY
#   AFIP_PRIVATE_KEY_PASSWORD
#
# Mercado Pago:
#   MERCADOPAGO_ACCESS_TOKEN
#   MERCADOPAGO_WEBHOOK_SECRET
#   MERCADOPAGO_PUBLIC_KEY
#
# Tenant-specific Maps server key:
#   GOOGLE_MAPS_SERVER_API_KEY
#
# Workflow provider credentials are also tenant-scoped and encrypted.
