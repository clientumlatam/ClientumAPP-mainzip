# ClientumCRM runtime variables
# Never commit real values. Store secrets in Replit Secrets.

PORT=5000
NODE_ENV=development
DISABLE_HMR=false

# Neon PostgreSQL (preferred). DATABASE_URL / PG* are compatibility fallbacks.
NEON_DATABASE_URL=
# DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Server encryption and internal API keys
WORKFLOW_ENCRYPTION_KEY=
API_KEY_PEPPER=
SESSION_SECRET=
CLIENTUM_API_KEY_ADMIN_IDS=

# Vercel REST API (keep the token server-side; prefer a project-scoped token)
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Cloudflare API (keep the token server-side and scope it to required resources)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Clerk is provisioned by Replit Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=https://www.clientum.com.ar
VITE_CLERK_PUBLISHABLE_KEY=
# Optional Clerk proxy and redirect configuration. Redirects default to /app.
VITE_CLERK_PROXY_URL=
VITE_CLERK_SIGN_IN_URL=
VITE_CLERK_SIGN_UP_URL=
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Platform billing: Clientum subscriptions only
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
APP_URL=
# Optional public analytics. Expose only the measurement ID with the VITE_ prefix.
VITE_GOOGLE_ANALYTICS_ID=
# Optional ARS prices; defaults are Starter 14900, Growth 29900, Scale 59900.
PLATFORM_PLAN_STARTER_ARS=14900
PLATFORM_PLAN_GROWTH_ARS=29900
PLATFORM_PLAN_SCALE_ARS=59900

# Optional platform services
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ClientumCRM
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Legacy Firebase client configuration. Remove after Clerk migration is confirmed.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Workspace credentials are entered in the app and encrypted server-side:
# MERCADOPAGO_ACCESS_TOKEN
# MERCADOPAGO_WEBHOOK_SECRET
# MERCADOPAGO_PUBLIC_KEY
# GOOGLE_MAPS_SERVER_API_KEY
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_BUSINESS_ACCOUNT_ID